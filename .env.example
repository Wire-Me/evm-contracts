SEPOLIA_PRIVATE_KEY_1=your_private_key_here
SEPOLIA_PRIVATE_KEY_2=your_private_key_here

# Base mainnet - real funds, real deployment. BASE_RPC_URL defaults to the public
# https://mainnet.base.org if unset. Leave the private keys unset unless you actually intend to
# run `npm run deploy-all:base`.
BASE_RPC_URL=
BASE_PRIVATE_KEY_1=your_private_key_here
BASE_PRIVATE_KEY_2=your_private_key_here

ETH_LOCAL_NODE_URL=http://localhost:8545

# Required by the `deploy-all` hardhat task (scripts/deploy/deployAllTask.ts) - real token
# contract addresses on the target network, not deployed by this repo.
USDC_ERC20_ADDRESS=
USDT_ERC20_ADDRESS=

# Optional overrides for `deploy-all`. ADMIN_ADDRESS defaults to the deploying signer;
# the deposit/duration defaults match FxEscrowMultiStorage's own defaults (500 units of a
# 6-decimal stablecoin, 48 hours).
ADMIN_ADDRESS=
MINIMUM_BROKER_DEPOSIT_AMOUNT=
EXPIRATION_DURATION_FOR_NON_BROKERS_SECONDS=